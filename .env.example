# ─── Client-side (exposed to the browser via Vite) ───────────────────────────
# Get these from your Supabase project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the API server (leave empty when using `vercel dev`, which serves
# both the frontend and the /api/* functions on the same origin at port 3000).
# Set this only if the API runs on a different port/host during development.
VITE_API_BASE_URL=

# ─── Server-side only (never expose these to the browser) ────────────────────
# Supabase service-role key — grants admin access; keep it secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Default AI model served when the client doesn't specify one.
# Use a free model to keep costs low, e.g.:
#   meta-llama/llama-3.1-8b-instruct:free
#   mistralai/mistral-7b-instruct:free
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Optional — Groq is only used as an automatic fallback in api/ai.js when every
# OpenRouter attempt fails. The app works fine with just OpenRouter configured;
# leave these unset if you don't want the fallback.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_DEFAULT_MODEL=your-preferred-groq-model

# Public URL of your deployed site (sent as HTTP-Referer to OpenRouter)
PUBLIC_SITE_URL=https://your-app.vercel.app

# Fish API key - see https://fishapi.com/dashboard
FISH_API_KEY=your-fish-api-key

# LibreTranslate (used by the Speech Translator feature at /translator)
# Point this at a self-hosted or hosted LibreTranslate instance — there is no
# public default. Quickest local option: `docker run -p 5000:5000 libretranslate/libretranslate`
LIBRETRANSLATE_URL=http://localhost:5000
# Optional — only needed for hosted/public instances that enforce an API key.
LIBRETRANSLATE_API_KEY=
